{
  "notifications": {
    "desktop": {
      "enabled": true,
      "sound": false,
      "volume": 0.25,
      "audioDevice": "",
      "appIcon": "${CLAUDE_PLUGIN_ROOT}/claude_icon.png",
      "clickToFocus": true,
      "showSessionLabel": false,
      "terminalBundleId": "com.googlecode.iterm2"
    },
    "webhook": {
      "enabled": false,
      "preset": "custom",
      "url": "",
      "format": "json",
      "headers": {}
    },
    "suppressQuestionAfterTaskCompleteSeconds": 7,
    "suppressForSubagents": true,
    "teamMode": "wait-all"
  },
  "statuses": {
    "task_complete": {
      "enabled": true,
      "title": "✅ Задача выполнена",
      "sound": "${CLAUDE_PLUGIN_ROOT}/sounds/task-complete.mp3"
    },
    "review_complete": {
      "enabled": true,
      "title": "🔍 Ревью завершено",
      "sound": "${CLAUDE_PLUGIN_ROOT}/sounds/review-complete.mp3"
    },
    "question": {
      "enabled": true,
      "title": "❓ Есть вопрос",
      "sound": "${CLAUDE_PLUGIN_ROOT}/sounds/question.mp3"
    },
    "plan_ready": {
      "enabled": true,
      "title": "📋 План готов",
      "sound": "${CLAUDE_PLUGIN_ROOT}/sounds/plan-ready.mp3"
    }
  }
}
